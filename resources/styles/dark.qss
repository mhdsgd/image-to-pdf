/* resources/styles/dark.qss */
QMainWindow {
    background-color: #2b2b2b;
}

QWidget {
    background-color: #3c3c3c;
    color: #ffffff;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QPushButton {
    background-color: #4a4a4a;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 8px 16px;
    color: #ffffff;
}

QPushButton:hover {
    background-color: #5a5a5a;
}

QPushButton:pressed {
    background-color: #6a6a6a;
}

QListWidget {
    background-color: #3c3c3c;
    border: 1px solid #555555;
    border-radius: 4px;
    color: #ffffff;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #4a4a4a;
}

QListWidget::item:selected {
    background-color: #1976d2;
    color: #ffffff;
}

QLabel {
    color: #ffffff;
}

QGroupBox {
    border: 1px solid #555555;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 15px;
    color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QComboBox, QSpinBox {
    background-color: #4a4a4a;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 5px;
    color: #ffffff;
}

QComboBox::drop-down {
    border: none;
}

QStatusBar {
    background-color: #3c3c3c;
    color: #cccccc;
}
